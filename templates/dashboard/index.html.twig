{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center mb-4">Bienvenue sur le <strong>Back Office</strong> 🛠️</h1>

    <div class="row justify-content-center mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow">
                <div class="card-body text-center">
                    <h5 class="card-title"><i class="fas fa-users"></i> Utilisateurs</h5>
                    <p class="display-6">{{ total_users }}</p>
                    <a href="{{ path('admin_utilisateurs') }}" class="btn btn-light mt-2">Gérer</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success shadow">
                <div class="card-body text-center">
                    <h5 class="card-title"><i class="fas fa-calendar-alt"></i> Événements</h5>
                    <p class="display-6">{{ total_events }}</p>
                    <a href="{{ path('admin_evenements') }}" class="btn btn-light btn-sm mt-2">Gérer</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-dark bg-warning shadow">
                <div class="card-body text-center">
                    <h5 class="card-title"><i class="fas fa-ticket-alt"></i> Réservations</h5>
                    <p class="display-6">{{ total_reservations }}</p>
                    <a href="{{ path('admin_reservations') }}" class="btn btn-dark btn-sm mt-2">Consulter</a>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">Retour au site</a>
    </div>
</div>
{% endblock %}