<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>QR Code - SP_EVENT</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 40px;
        }

        .wrapper {
            border: 1px solid #ccc;
            border-radius: 15px;
            padding: 30px;
            max-width: 500px;
            margin: auto;
            box-shadow: 0 0 8px rgba(0,0,0,0.1);
        }

        h1 {
            color: #2c3e50;
            font-size: 22px;
            margin-bottom: 30px;
        }

        .event-title {
            font-size: 18px;
            font-weight: bold;
            margin: 20px 0 10px;
        }

        p {
            margin: 5px 0;
            font-size: 14px;
        }

        .qr {
            margin: 30px 0;
        }

        .event-image {
            margin-top: 20px;
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            border: 1px solid #ddd;
        }
    </style>
</head>
<body>

    <h1>🎟️ SP_EVENT - Billet Électronique</h1>

    <div class="wrapper">
        <div class="event-title">{{ titre }}</div>

        <p><strong>Date :</strong> {{ date|date('d/m/Y') }}</p>
        <p><strong>Ville :</strong> {{ ville }}</p>
        <p><strong>Nom :</strong> {{ nom }}</p>
        <p><strong>Email :</strong> {{ email }}</p>

        <div class="qr">
            <img src="{{ qrCode }}" alt="QR Code">
        </div>

        {% if eventImage %}
            <img src="{{ eventImage }}" class="event-image" alt="Image de l'événement">
        {% endif %}
    </div>

</body>
</html>